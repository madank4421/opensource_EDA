digraph "ripple_counter" {
label="ripple_counter";
rankdir="LR";
remincross=true;
n4 [ shape=diamond, label="q_int", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="q", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="reset", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c11 [ shape=record, label="{{<p8> A|<p9> B}|$3\n$xor|{<p10> Y}}" ];
x0 [ shape=record, style=rounded, label="<s0> 0:0 - 0:0 " ];
x0:e -> c11:p9:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", label=""];
x1 [ shape=record, style=rounded, label="<s0> 1:1 - 0:0 " ];
x1:e -> c11:p8:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", label=""];
c12 [ shape=record, label="{{<p8> A}|$2\n$not|{<p10> Y}}" ];
x2 [ shape=record, style=rounded, label="<s0> 0:0 - 0:0 " ];
x2:e -> c12:p8:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", label=""];
x4 [ shape=record, style=rounded, label="<s0> 0:0 - 1:1 " ];
x5 [ shape=record, style=rounded, label="<s0> 0:0 - 0:0 " ];
p3 [shape=box, style=rounded, label="PROC $1\n./designs/ripple_counter/src/ripple_counter.v:5.1-14.4"];
x6 [shape=box, style=rounded, label="BUF"];
c11:p10:e -> p3:w [color="black", label=""];
c12:p10:e -> p3:w [color="black", label=""];
n3 [ shape=point ];
p3:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
x4:s0:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
x5:s0:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
n3:e -> p3:w [color="black", style="setlinewidth(3)", label=""];
p3:e -> n4:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> p3:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> x0:s0:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> x1:s0:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> x2:s0:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> x6:w:w [color="black", style="setlinewidth(3)", label=""];
x6:e:e -> n5:w [color="black", style="setlinewidth(3)", label=""];
n6:e -> p3:w [color="black", label=""];
n7:e -> p3:w [color="black", label=""];
p3:e -> x4:w [color="black", label=""];
p3:e -> x5:w [color="black", label=""];
}
